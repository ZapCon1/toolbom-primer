{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZapCon1/toolbom-primer/schema/purchase-lists.schema.json",
  "title": "Tool library purchase lists",
  "description": "BOM rows combined into tool, holder and collet purchase lists (see docs/COMBINE.md).",
  "type": "object",
  "required": ["source", "tools", "holders", "collets"],
  "additionalProperties": false,
  "properties": {
    "source": { "enum": ["mastercam", "fusion"] },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brand", "part_number", "description", "hyperlink", "shank", "quantity", "tool_numbers"],
        "properties": {
          "brand": { "type": "string" },
          "part_number": { "type": "string" },
          "description": { "type": "string" },
          "hyperlink": { "type": "string" },
          "shank": { "$ref": "bom.schema.json#/$defs/shank" },
          "quantity": { "type": "integer", "minimum": 0, "description": "Sum of the rows' quantities, a blank counting as 1." },
          "tool_numbers": { "$ref": "#/$defs/toolNumbers" }
        }
      }
    },
    "holders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brand", "part_number", "description", "hyperlink", "spindle_taper", "quantity", "tool_numbers"],
        "properties": {
          "brand": { "type": "string" },
          "part_number": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "hyperlink": { "type": "string" },
          "spindle_taper": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1, "description": "Number of assemblies using this holder." },
          "tool_numbers": { "$ref": "#/$defs/toolNumbers" }
        }
      }
    },
    "collets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collet", "holder", "shank", "quantity", "tool_numbers"],
        "properties": {
          "collet": { "type": "string", "minLength": 1 },
          "holder": { "type": "string", "description": "Holder brand and part number of the first assembly using it." },
          "shank": { "$ref": "bom.schema.json#/$defs/shank" },
          "quantity": { "type": "integer", "minimum": 1, "description": "Number of assemblies using this collet." },
          "tool_numbers": { "$ref": "#/$defs/toolNumbers" }
        }
      }
    }
  },
  "$defs": {
    "toolNumbers": {
      "type": "array",
      "description": "T numbers where the part is used, ascending, no repeats.",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    }
  }
}
